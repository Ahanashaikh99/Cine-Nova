{
  "info": {
    "name": "Movie App Backend (TMDb)",
    "description": "Before running, select the environment 'Movie App - Local (Docker)' or update the Collection's baseUrl variable to match your URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "default"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Genres - movie",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/genres",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "genres"
          ],
          "query": [
            {
              "key": "type",
              "value": "movie"
            }
          ]
        }
      }
    },
    {
      "name": "Genres - tv",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/genres",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "genres"
          ],
          "query": [
            {
              "key": "type",
              "value": "tv"
            }
          ]
        }
      }
    },
    {
      "name": "Discover - slide example (genre+year+rating+sort)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ],
          "query": [
            {
              "key": "genre",
              "value": "28"
            },
            {
              "key": "year",
              "value": "2023"
            },
            {
              "key": "min_rating",
              "value": "7"
            },
            {
              "key": "sort",
              "value": "popularity"
            }
          ]
        }
      }
    },
    {
      "name": "Discover - default (popular movies)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ]
        }
      }
    },
    {
      "name": "Discover - genre (Action AND Adventure)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ],
          "query": [
            {
              "key": "genre",
              "value": "28,12"
            }
          ]
        }
      }
    },
    {
      "name": "Discover - genre (Action OR Comedy)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ],
          "query": [
            {
              "key": "genre",
              "value": "28|35"
            }
          ]
        }
      }
    },
    {
      "name": "Discover - year",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ],
          "query": [
            {
              "key": "year",
              "value": "2023"
            }
          ]
        }
      }
    },
    {
      "name": "Discover - rating 8+ sorted by rating",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ],
          "query": [
            {
              "key": "min_rating",
              "value": "8"
            },
            {
              "key": "sort",
              "value": "vote_average"
            },
            {
              "key": "order",
              "value": "desc"
            }
          ]
        }
      }
    },
    {
      "name": "Discover - date range, newest first",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ],
          "query": [
            {
              "key": "date_from",
              "value": "2020-01-01"
            },
            {
              "key": "date_to",
              "value": "2022-12-31"
            },
            {
              "key": "sort",
              "value": "release_date"
            },
            {
              "key": "order",
              "value": "desc"
            }
          ]
        }
      }
    },
    {
      "name": "Discover - combined filters (movie)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ],
          "query": [
            {
              "key": "type",
              "value": "movie"
            },
            {
              "key": "genre",
              "value": "878"
            },
            {
              "key": "year",
              "value": "2022"
            },
            {
              "key": "min_rating",
              "value": "7"
            },
            {
              "key": "sort",
              "value": "popularity"
            },
            {
              "key": "order",
              "value": "desc"
            },
            {
              "key": "page",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "Discover - TV shows",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ],
          "query": [
            {
              "key": "type",
              "value": "tv"
            },
            {
              "key": "genre",
              "value": "18"
            },
            {
              "key": "min_rating",
              "value": "8"
            }
          ]
        }
      }
    },
    {
      "name": "ERROR - invalid sort (expect 400)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ],
          "query": [
            {
              "key": "sort",
              "value": "hacked"
            }
          ]
        }
      }
    },
    {
      "name": "ERROR - rating out of range (expect 400)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/discover",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "discover"
          ],
          "query": [
            {
              "key": "min_rating",
              "value": "11"
            }
          ]
        }
      }
    },
    {
      "name": "ERROR - unknown route (expect 404)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/unknown",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "unknown"
          ]
        }
      }
    }
  ]
}