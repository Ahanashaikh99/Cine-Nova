{
  "info": {
    "name": "Movie App Backend (TMDb)",
    "description": "Filters demo (movie only). Start the server first (docker compose up --build, http://localhost:5001). If you use another port, replace 5001 in the request URLs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5001/api/health",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5001",
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Genres - movie",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5001/api/genres",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5001",
          "path": [
            "api",
            "genres"
          ],
          "query": [
            {
              "key": "type",
              "value": "movie"
            }
          ]
        }
      }
    },
    {
      "name": "Discover - default (popular movies)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5001/api/discover",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5001",
          "path": [
            "api",
            "discover"
          ]
        }
      }
    },
    {
      "name": "Discover - slide example (genre+year+rating+sort)",
