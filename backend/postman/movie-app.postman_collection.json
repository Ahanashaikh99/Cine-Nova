            "discover"
          ],
          "query": [
            {
              "key": "genre",
              "value": "28"
            },
            {
              "key": "year",
              "value": "2023"
            },
            {
              "key": "min_rating",
              "value": "7"
            },
            {
              "key": "sort",
              "value": "popularity"
            }
          ]
        }
      }
    },
